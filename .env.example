# === Backend (Django API) ===
SECURITY_KEY_API=django-insecure-your-super-secret-key-here
FERNET_KEY=your-fernet-key-here # Generate one or leave empty to autogenerate
DEBUG_API=True

# === Database (PostgreSQL) ===
DB_NAME=aion_db
DB_USER=aion_user
DB_PASSWORD=aion_password
DB_HOST=db

# === pgAdmin ===
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# === Ports ===
NODE_PORT=9000
API_PORT=8000
